# Fyers API credentials — copy this file to `.env` and fill in your values.
# Get these by creating an app at https://myapi.fyers.in/dashboard
# IMPORTANT: the redirect URI below must match EXACTLY what you register in the Fyers app.
#
# For LOCAL dev, FYERS_REDIRECT_URI/FRONTEND_URL below take effect.
# For PRODUCTION (Render), these are derived automatically from RENDER_EXTERNAL_URL
# (https://<app>.onrender.com) — just set FYERS_APP_ID + FYERS_SECRET there.

FYERS_APP_ID=YOUR_APP_ID-100
FYERS_SECRET=YOUR_SECRET_KEY
FYERS_REDIRECT_URI=http://localhost:3001/api/fyers/callback
PORT=3001
FRONTEND_URL=http://localhost:5173
